{
  "name": "haiwenna-clipflow",
  "private": true,
  "version": "0.1.2",
  "description": "A fluid, modern Windows clipboard manager built with Tauri 2 + Rust + React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haiwen619/Haiwenna-ClipFlow.git"
  },
  "homepage": "https://github.com/haiwen619/Haiwenna-ClipFlow",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
